{
  "name": "@onengo-console/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsx ../../../packages/common/build-app.ts onengo-console --production",
    "build:dev": "tsx ../../../packages/common/build-app.ts onengo-console --development",
    "start": "node --enable-source-maps dist/server.js",
    "start:dev": "tsx src/main.ts",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@onengo/kernel": "0.1.0",
    "@onengo/platform": "0.1.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
