{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "operator": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "op",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/operator",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": true
              },
              "outputHashing": "all",
              "budgets": [{ "type": "initial", "maximumWarning": "275kB", "maximumError": "400kB" }]
            },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "prebundle": false },
          "configurations": {
            "production": { "buildTarget": "operator:build:production" },
            "development": { "buildTarget": "operator:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
