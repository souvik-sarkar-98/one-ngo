{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "guide": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "guide",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/guide",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "budgets": [{ "type": "initial", "maximumWarning": "275kB", "maximumError": "400kB" }]
            },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "prebundle": false, "servePath": "/guide-app/" },
          "configurations": {
            "production": { "buildTarget": "guide:build:production" },
            "development": { "buildTarget": "guide:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
