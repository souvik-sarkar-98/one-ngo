# Local settings for the NGO platform server.
# Copy to .env and fill in TOKEN_SECRET and ENCRYPTION_KEY.
# .env is ignored by git. Never commit real secrets.

# ---------------------------------------------------------------- required

# Signs access tokens. At least 32 characters. Changing it signs everyone out.
TOKEN_SECRET=

# 32 random bytes, base64. Encrypts two-step secrets, gateway credentials and
# sensitive record values. Changing it without listing the old key in
# ENCRYPTION_KEY_PREVIOUS makes them unreadable.
ENCRYPTION_KEY=
# Optional. Earlier values of ENCRYPTION_KEY, comma separated, each 32 bytes
# base64. Sensitive record values, two-step and gateway secrets encrypted with
# them still read; to rotate, put the old key here and a new one in
# ENCRYPTION_KEY, run npm run fields:reencrypt (rewrites the secrets and queues
# the record jobs), then remove the old key once the jobs are done.
ENCRYPTION_KEY_PREVIOUS=

# ---------------------------------------------------------------- database

# Owner URL for the one-shot deploy and re-encryption commands only. Never add
# this variable or DATABASE_URL to either serving service manifest.
DATABASE_OWNER_URL=postgres://ngo_owner:LOCAL_ONLY@localhost:5432/ngo
# Main serving logins. The system role may call only reviewed security-definer
# functions; the runtime role is an app_runtime member and owns no objects.
DATABASE_SYSTEM_URL=postgres://ngo_main_system_login:LOCAL_ONLY@localhost:5432/ngo
DATABASE_RUNTIME_URL=postgres://ngo_main_runtime_login:LOCAL_ONLY@localhost:5432/ngo
# Operator serving logins. Keep these distinct from both main logins and owner.
OPERATOR_DATABASE_URL=postgres://ngo_operator_login:LOCAL_ONLY@localhost:5432/ngo
OPERATOR_RUNTIME_URL=postgres://ngo_operator_runtime_login:LOCAL_ONLY@localhost:5432/ngo
# Local setup and tests may use an administrative URL explicitly. No serving
# process reads DATABASE_URL.
DATABASE_URL=postgres://postgres@localhost:5432/ngo
DATABASE_POOL_SIZE=3
# one-ngo (default when empty) or shared. Every process refuses unsupported
# connection schemes and PostgreSQL before 15.
INSTALLATION_MODE=

# ---------------------------------------------------------------- operator

# Operator values are separate secrets/configuration. Do not reuse TOKEN_SECRET,
# OIDC credentials, or either main database login, and keep OPERATOR_ENCRYPTION_KEY
# different from ENCRYPTION_KEY. The console also reads ENCRYPTION_KEY (and
# ENCRYPTION_KEY_PREVIOUS): it stores organisation sign-in secrets the main server
# reads. It reads the non-secret OIDC_* values to show the shared provider. The
# operator browser uses the distinct __Host-ngo_operator cookie.
OPERATOR_PUBLIC_BASE_URL=http://localhost:8081
OPERATOR_ENCRYPTION_KEY=
OPERATOR_INTERNAL_TOKEN_SECRET=
OPERATOR_OIDC_ISSUER=
OPERATOR_OIDC_CLIENT_ID=
OPERATOR_OIDC_CLIENT_SECRET=
OPERATOR_OIDC_AUDIENCE=
OPERATOR_OIDC_MFA_ACR=
# Required outside local mode. The Identity-Aware Proxy audience
# (/projects/<number>/apps/<project id>). Every request must carry a valid IAP
# assertion. Leave empty only when OPERATOR_LOCAL_WITHOUT_IAP=1 (npm run dev).
# A cloud process refuses to start when this is empty.
OPERATOR_IAP_AUDIENCE=

# Start PostgreSQL yourself before npm run dev:setup. The setup script does not
# start the service.
# PG_BIN=
# PGDATA=

# ---------------------------------------------------------------- web

PORT=8080
# Address people use to reach the app; used in emailed links and sign-in redirects.
# Sign-in cookies are always Secure; browsers accept them over plain http only on localhost.
PUBLIC_BASE_URL=http://localhost:8080
# Extra web origins allowed to run passkey ceremonies, comma separated. The public address
# above is always allowed; localhost also allows the Angular dev server on port 4200.
PASSKEY_ORIGINS=
# Browser origins allowed to call this API when the web app is served elsewhere,
# comma separated. Empty keeps the app same-origin only. The Angular dev server
# already proxies /api, so leave this empty unless the browser calls this host
# directly. Example: http://localhost:4200
# A listed origin gets credentialed CORS. Its refresh cookie is SameSite=None
# and Secure, which browsers accept on localhost over plain http.
CORS_ORIGINS=
# Shipped modules to publish on start, comma separated.
SHIPPED_MODULES=donations

# ---------------------------------------------------------------- passwords

# online = Have I Been Pwned range check (only 5 hash characters leave the server); off = skip.
BREACHED_PASSWORD_CHECK=online
# Optional extra common-password list, one per line.
COMMON_PASSWORDS_FILE=

# ---------------------------------------------------------------- email (optional)

# Without these, sign-in codes, reset links, and invitations are not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------- shared sign-in provider (optional)

# One OpenID Connect provider every NGO on this installation may opt into. Empty
# OIDC_CLIENT_ID offers none. Register this redirect URI with the provider:
# <PUBLIC_BASE_URL>/api/auth/oidc/callback
# Empty OIDC_ISSUER means Google (https://accounts.google.com).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma separated. Empty accepts any verified email of an existing member.
OIDC_ALLOWED_DOMAINS=
# Defaults: google and Google for the Google issuer, sso and Single sign-on otherwise.
# Keep the id once NGOs have opted in; their opt-in is stored under it.
OIDC_PROVIDER_ID=
OIDC_PROVIDER_LABEL=
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_ALLOWED_DOMAINS and GOOGLE_ISSUER
# are still read when the matching OIDC_* value is empty. They are deprecated.

# ---------------------------------------------------------------- payment gateway hosts (optional)

# Empty uses the real gateways. CASHFREE_API_BASE replaces both the sandbox and production hosts.
RAZORPAY_API_BASE=
CASHFREE_API_BASE=

# ---------------------------------------------------------------- scheduler and audit (optional)

# Lets something other than App Engine cron call POST /internal/tick with "Authorization: Bearer <value>".
TICK_SECRET=
# Archive audit events older than AUDIT_RETENTION_DAYS, then remove them from the database.
# Leave both empty to keep every audit event in the database.
# On App Engine use a Cloud Storage bucket (local disk does not persist); objects are written as
# <AUDIT_ARCHIVE_PREFIX><organisation id>/audit-<first id>-<last id>.jsonl.gz
AUDIT_ARCHIVE_BUCKET=
AUDIT_ARCHIVE_PREFIX=audit-archive/
# A local folder, used only when AUDIT_ARCHIVE_BUCKET is empty.
AUDIT_ARCHIVE_DIR=
# Whole days audit events stay in the database before archiving (default 548, one and a half years).
AUDIT_RETENTION_DAYS=548
# Years journals, receipts and payments are kept after their date. PENDING COUNSEL CONFIRMATION; unset is 8.
FINANCIAL_RETENTION_YEARS=

# ---------------------------------------------------------------- alerts (optional)

# Resident memory in MB above which the server logs a memory.high alert (checked every minute and on each tick).
MEMORY_ALERT_MB=300
