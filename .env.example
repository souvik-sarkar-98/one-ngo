# Local settings for the NGO platform server.
# Copy to .env and fill in TOKEN_SECRET and ENCRYPTION_KEY.
# .env is ignored by git. Never commit real secrets.

# ---------------------------------------------------------------- required

# Signs access tokens. At least 32 characters. Changing it signs everyone out.
TOKEN_SECRET=

# 32 random bytes, base64. Encrypts two-step secrets, gateway credentials and
# sensitive record values. Changing it without listing the old key in
# ENCRYPTION_KEY_PREVIOUS makes them unreadable.
ENCRYPTION_KEY=
# Optional. Earlier values of ENCRYPTION_KEY, comma separated, each 32 bytes
# base64. Sensitive record values, two-step and gateway secrets encrypted with
# them still read; to rotate, put the old key here and a new one in
# ENCRYPTION_KEY, run npm run fields:reencrypt (rewrites the secrets and queues
# the record jobs), then remove the old key once the jobs are done.
ENCRYPTION_KEY_PREVIOUS=

# ---------------------------------------------------------------- database
#
# PostgreSQL 15 or newer. Every connection string is postgres:// or postgresql://:
#   postgres://<user>:<password>@<host>:<port>/<database>
# The database name is lowercase letters, digits, and underscore. "postgres"
# is the maintenance database, so pick an application name such as ngo.
# Tests use that name plus _test (ngo becomes ngo_test).
#
# Local development needs only DATABASE_URL. Leave the other database URLs
# empty. npm run dev:setup and npm run dev copy DATABASE_URL into the owner,
# system, and operator URLs, and they create non-superuser runtime logins:
#   ngo_main_runtime_local          member of ngo_main_runtime
#   ngo_op_rt_<database>            member of ngo_operator_runtime
# Those group roles are created by the migrations, so run npm run dev:setup
# once before npm run dev. The runtime password stays in that process and is
# not written back here.
#
# A runtime URL set to the postgres superuser is refused at startup. The
# superuser can bypass row-level security, so tenant traffic must use the
# login the dev script creates.
#
# Production uses a different login for each URL below. The owner login is
# only for the one-shot deploy step. The main service receives the two main
# URLs, and the operator service receives the two operator URLs. Do not put
# DATABASE_URL or DATABASE_OWNER_URL in either serving manifest.
#
#   DATABASE_OWNER_URL=postgres://ngo_owner:SECRET@10.0.0.5:5432/ngo
#   DATABASE_SYSTEM_URL=postgres://ngo_main_system_login:SECRET@10.0.0.5:5432/ngo
#   DATABASE_RUNTIME_URL=postgres://ngo_main_runtime_login:SECRET@10.0.0.5:5432/ngo
#   OPERATOR_DATABASE_URL=postgres://ngo_operator_login:SECRET@10.0.0.5:5432/ngo
#   OPERATOR_RUNTIME_URL=postgres://ngo_operator_runtime_login:SECRET@10.0.0.5:5432/ngo
#
# Who may connect as what:
#   owner            owns the schema; migrations and fields:reencrypt
#   ngo_main_system  main API, reviewed cross-tenant functions only
#   ngo_main_runtime main API tenant requests; member of app_runtime; no
#                    superuser, no bypass of row-level security, owns nothing
#   ngo_operator     console control plane (onboard, suspend, close)
#   ngo_operator_runtime
#                    console writes into one organisation; same limits as
#                    ngo_main_runtime

# Local setup, seeds, and tests. Serving processes do not read this.
# Example: postgres://postgres@localhost:5432/ngo
DATABASE_URL=postgres://postgres@localhost:5432/ngo
# Deploy and re-encryption only (npm run deploy:prepare, npm run fields:reencrypt).
# Leave empty locally; dev:setup copies DATABASE_URL.
DATABASE_OWNER_URL=
# Main API work outside any one tenant, used by asSystem() (for example
# registering the tenant bind key). Leave empty locally; npm run dev copies
# DATABASE_URL. Production login is a member of ngo_main_system and may run only
# the reviewed functions granted to that role.
#
# DATABASE_RUNTIME_URL is the opposite: every request for one organisation runs
# inside withTenant(), which switches to app_runtime with that tenant set, so
# row-level security limits the rows it can see.
DATABASE_SYSTEM_URL=
# Main API tenant requests. Leave empty locally; npm run dev creates
# ngo_main_runtime_local. Production example:
#   postgres://ngo_main_runtime_login:SECRET@10.0.0.5:5432/ngo
DATABASE_RUNTIME_URL=
# Operator console control plane. Leave empty locally; the console dev script
# copies DATABASE_URL. Production login is a member of ngo_operator.
OPERATOR_DATABASE_URL=
# Operator console tenant writes. Leave empty locally; the console dev script
# creates ngo_op_rt_<database>. Production example:
#   postgres://ngo_operator_runtime_login:SECRET@10.0.0.5:5432/ngo
OPERATOR_RUNTIME_URL=
# Main API pool size. Defaults to 3 when empty. The operator console uses 2.
DATABASE_POOL_SIZE=3
# Empty means one-ngo (one organisation on this server). shared resolves the
# organisation from the signed-in identity. Any other value is refused.
INSTALLATION_MODE=

# ---------------------------------------------------------------- operator

# Operator values are separate secrets/configuration. Do not reuse TOKEN_SECRET,
# OIDC credentials, or either main database login, and keep OPERATOR_ENCRYPTION_KEY
# different from ENCRYPTION_KEY. The console also reads ENCRYPTION_KEY (and
# ENCRYPTION_KEY_PREVIOUS): it stores organisation sign-in secrets the main server
# reads. It reads the non-secret OIDC_* values to show the shared provider. The
# operator browser uses the distinct __Host-ngo_operator cookie.
OPERATOR_PUBLIC_BASE_URL=http://localhost:8081
OPERATOR_ENCRYPTION_KEY=
OPERATOR_INTERNAL_TOKEN_SECRET=
OPERATOR_OIDC_ISSUER=
OPERATOR_OIDC_CLIENT_ID=
OPERATOR_OIDC_CLIENT_SECRET=
OPERATOR_OIDC_AUDIENCE=
OPERATOR_OIDC_MFA_ACR=
# Required outside local mode. The Identity-Aware Proxy audience
# (/projects/<number>/apps/<project id>). Every request must carry a valid IAP
# assertion. Leave empty only when OPERATOR_LOCAL_WITHOUT_IAP=1 (npm run dev).
# A cloud process refuses to start when this is empty.
OPERATOR_IAP_AUDIENCE=

# Start PostgreSQL yourself before npm run dev:setup. The setup script does not
# start the service.
# PG_BIN=
# PGDATA=

# ---------------------------------------------------------------- web

PORT=8080
# Address people use to reach the app; used in emailed links and sign-in redirects.
# Sign-in cookies are always Secure; browsers accept them over plain http only on localhost.
PUBLIC_BASE_URL=http://localhost:8080
# Extra web origins allowed to run passkey ceremonies, comma separated. The public address
# above is always allowed; localhost also allows the Angular dev server on port 4200.
PASSKEY_ORIGINS=
# Browser origins allowed to call this API when the web app is served elsewhere,
# comma separated. Empty keeps the app same-origin only. The Angular dev server
# already proxies /api, so leave this empty unless the browser calls this host
# directly. Example: http://localhost:4200
# A listed origin gets credentialed CORS. Its refresh cookie is SameSite=None
# and Secure, which browsers accept on localhost over plain http.
CORS_ORIGINS=
# Shipped modules to publish on start, comma separated.
SHIPPED_MODULES=donations

# ---------------------------------------------------------------- passwords

# online = Have I Been Pwned range check (only 5 hash characters leave the server); off = skip.
BREACHED_PASSWORD_CHECK=online
# Empty uses Have I Been Pwned. The service sandbox block below has the local stand-in.
PWNED_PASSWORDS_API_BASE=
# Optional extra common-password list, one per line.
COMMON_PASSWORDS_FILE=

# ---------------------------------------------------------------- email

# Outgoing email is sent only through each organisation's email connector
# (Administration, Connectors: send all of this organisation's email through
# that connector). There is no SMTP fallback. Until that connector is on,
# the setup checklist stays open, and sign-in codes, password resets and
# other email are refused with a message that asks the person to contact
# an administrator.

# ---------------------------------------------------------------- local service sandbox (optional)

# The sandbox is its own process. npm run dev starts it unless you pass
# --no-sandbox. It does not fill these values. Leave a key empty to keep the
# real service, and copy a line only for the stand-in you want. Restart after
# editing. Set the certificate before any call to the sandbox's HTTPS origin.
# NODE_EXTRA_CA_CERTS=<absolute path to this repo>/.data/service-sandbox/tls/ca.crt  (must be absolute)
# OIDC_ISSUER=https://127.0.0.1:8095
# OIDC_CLIENT_ID=demo-google
# OIDC_CLIENT_SECRET=demo-google-secret
# OIDC_PROVIDER_ID=google
# OIDC_PROVIDER_LABEL=Google
# OPERATOR_OIDC_ISSUER=https://127.0.0.1:8095
# OPERATOR_OIDC_CLIENT_ID=demo-operator
# OPERATOR_OIDC_CLIENT_SECRET=demo-operator-secret
# OPERATOR_OIDC_AUDIENCE=demo-operator
# RAZORPAY_API_BASE=https://127.0.0.1:8095
# CASHFREE_API_BASE=https://127.0.0.1:8095
# CONNECTOR_ALLOWED_HOSTS=127.0.0.1
# PWNED_PASSWORDS_API_BASE=https://127.0.0.1:8095

# ---------------------------------------------------------------- shared sign-in provider (optional)

# One OpenID Connect provider every NGO on this installation may opt into. Empty
# OIDC_CLIENT_ID offers none. Register this redirect URI with the provider:
# <PUBLIC_BASE_URL>/api/auth/oidc/callback
# Empty OIDC_ISSUER means Google (https://accounts.google.com).
# The service sandbox block above has the local stand-in values.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma separated. Empty accepts any verified email of an existing member.
OIDC_ALLOWED_DOMAINS=
# Defaults: google and Google for the Google issuer, sso and Single sign-on otherwise.
# Keep the id once NGOs have opted in; their opt-in is stored under it.
OIDC_PROVIDER_ID=
OIDC_PROVIDER_LABEL=
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_ALLOWED_DOMAINS and GOOGLE_ISSUER
# are still read when the matching OIDC_* value is empty. They are deprecated.

# ---------------------------------------------------------------- payment gateway hosts (optional)

# Empty uses the real gateways. CASHFREE_API_BASE replaces both the Cashfree sandbox and production hosts.
# The service sandbox block above has the local stand-in values.
RAZORPAY_API_BASE=
CASHFREE_API_BASE=

# ---------------------------------------------------------------- scheduler and audit (optional)

# Lets something other than App Engine cron call POST /internal/tick with "Authorization: Bearer <value>".
TICK_SECRET=
# Archive audit events older than AUDIT_RETENTION_DAYS, then remove them from the database.
# Leave both empty to keep every audit event in the database.
# On App Engine use a Cloud Storage bucket (local disk does not persist); objects are written as
# <AUDIT_ARCHIVE_PREFIX><organisation id>/audit-<first id>-<last id>.jsonl.gz
AUDIT_ARCHIVE_BUCKET=
AUDIT_ARCHIVE_PREFIX=audit-archive/
# A local folder, used only when AUDIT_ARCHIVE_BUCKET is empty.
AUDIT_ARCHIVE_DIR=
# Whole days audit events stay in the database before archiving (default 548, one and a half years).
AUDIT_RETENTION_DAYS=548
# Years journals, receipts and payments are kept after their date. PENDING COUNSEL CONFIRMATION; unset is 8.
FINANCIAL_RETENTION_YEARS=

# ---------------------------------------------------------------- alerts (optional)

# Resident memory in MB above which the server logs a memory.high alert (checked every minute and on each tick).
MEMORY_ALERT_MB=300
