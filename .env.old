# Local settings for the NGO platform server.
# Copy to .env (scripts/dev.ps1 does this and fills in the secrets for you).
# .env is ignored by git. Never commit real secrets.

# ---------------------------------------------------------------- required

# Signs access tokens. At least 32 characters. Changing it signs everyone out.
TOKEN_SECRET=bded0352f12157d0b8a7c8b2e8d9fb07b64ca5f344adf9b2b72dfa2a718961af

# 32 random bytes, base64. Encrypts two-step secrets, gateway credentials and
# sensitive record values. Changing it without listing the old key in
# ENCRYPTION_KEY_PREVIOUS makes them unreadable.
ENCRYPTION_KEY=jBbAZ6KOOzgiGmVwsVXorimEaCBmMlyfxv7pkdbcRXY=
# Optional. Earlier values of ENCRYPTION_KEY, comma separated, each 32 bytes
# base64. Sensitive record values, two-step and gateway secrets encrypted with
# them still read; to rotate, put the old key here and a new one in
# ENCRYPTION_KEY, run npm run fields:reencrypt (rewrites the secrets and queues
# the record jobs), then remove the old key once the jobs are done.
ENCRYPTION_KEY_PREVIOUS=

# ---------------------------------------------------------------- database

# PostgreSQL database for the app. Required. scripts/dev.ps1 starts local
# PostgreSQL if needed and creates this database when it is missing.
# Tests use <name>_test on the same server, one throwaway schema per test.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/one_ngo
DATABASE_POOL_SIZE=3
# one-ngo (default when empty) or shared. The server and the deploy step refuse
# anything else, any DATABASE_URL that is not postgres:// or postgresql://, and
# PostgreSQL before 15.
INSTALLATION_MODE=

# Local PostgreSQL install, for scripts/dev.ps1. Defaults: pg_ctl on PATH, else
# %LOCALAPPDATA%\postgres\pgsql\bin; data in %LOCALAPPDATA%\postgres\data.
# PG_BIN=C:\Users\me\AppData\Local\postgres\pgsql\bin
# PGDATA=C:\Users\me\AppData\Local\postgres\data

# ---------------------------------------------------------------- web

PORT=8080
# Address people use to reach the app; used in emailed links and sign-in redirects.
# Sign-in cookies are always Secure; browsers accept them over plain http only on localhost.
PUBLIC_BASE_URL=http://localhost:8080
# Browser origins allowed to call this API when the web app is served elsewhere,
# comma separated. Empty keeps the app same-origin only. The Angular dev server
# already proxies /api, so leave this empty unless the browser calls this host
# directly. Example: http://localhost:4200
# A listed origin gets credentialed CORS. Its refresh cookie is SameSite=None
# and Secure, which browsers accept on localhost over plain http.
CORS_ORIGINS=
# Shipped modules to publish on start, comma separated.
SHIPPED_MODULES=donations

# ---------------------------------------------------------------- demo data

# Password for admin@demo.local, created by the seed step (organisation code: demo).
#DEMO_PASSWORD=Password@01

# ---------------------------------------------------------------- passwords

# online = Have I Been Pwned range check (only 5 hash characters leave the server); off = skip.
BREACHED_PASSWORD_CHECK=online
# Optional extra common-password list, one per line.
COMMON_PASSWORDS_FILE=

# ---------------------------------------------------------------- email (optional)

# Without these, sign-in codes, reset links, and invitations are not sent.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=2525
# SMTP_SECURE=0
# SMTP_USER=demo
# SMTP_PASSWORD=demo
# SMTP_FROM=demo@localhost

# ---------------------------------------------------------------- Google sign-in (optional)

# Redirect URI to register in Google Cloud Console: <PUBLIC_BASE_URL>/api/auth/oidc/callback
GOOGLE_ISSUER=https://127.0.0.1:8095
GOOGLE_CLIENT_ID=demo-google
GOOGLE_CLIENT_SECRET=demo-google-secret

# ---------------------------------------------------------------- scheduler and audit (optional)

# Lets something other than App Engine cron call POST /internal/tick with "Authorization: Bearer <value>".
TICK_SECRET=
# Archive audit events older than AUDIT_RETENTION_DAYS into this folder, then remove them.
AUDIT_ARCHIVE_DIR=
AUDIT_RETENTION_DAYS=730
# Years journals, receipts and payments are kept after their date. PENDING COUNSEL CONFIRMATION; unset is 8.
FINANCIAL_RETENTION_YEARS=

# ---------------------------------------------------------------- alerts (optional)

# Resident memory in MB above which the server logs a memory.high alert (checked every minute and on each tick).
MEMORY_ALERT_MB=300
PG_BIN=C:\Users\ssarkar392\AppData\Local\postgres\pgsql\bin
PGDATA=C:\Users\ssarkar392\AppData\Local\postgres\data


# Trust the fixture certificate (one-ngo reads this at process start).       
NODE_EXTRA_CA_CERTS=C:\Users\ssarkar392\CEResources\integrated\one-ngo\.data\integration-demo\8095\tls\ca.crt



RAZORPAY_API_BASE=https://127.0.0.1:8095
CASHFREE_API_BASE=https://127.0.0.1:8095

CONNECTOR_ALLOWED_HOSTS=127.0.0.1

# Unchanged: one-ngo always sends Cloud Storage calls to this fixture.       
# FILE_STORE_BUCKET=<keep your value; set one to store files here>
# FILE_STORE_PREFIX=<keep your value>

OPERATOR_ENCRYPTION_KEY=7DIGbG2LVOKsVUYX4uEnalOr8aufeWzeleZACFK0HKE=
OPERATOR_INTERNAL_TOKEN_SECRET=1cd6c161434c0ca55a93c1868a152236e335b24da872318423b9e5d19348f89f
