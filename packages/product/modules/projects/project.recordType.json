    { "key": "endsOn", "label": "Ends on", "type": "date" },
    { "key": "budget", "label": "Budget", "type": "money", "min": 0 },
    { "key": "location", "label": "Location", "type": "text", "maxLength": 200, "searchable": true },
    { "key": "lead", "label": "Project lead", "type": "person" },
    {
