{
  "key": "donationSummary",
  "kind": "document",
  "label": "Donation summary",
  "subject": "Donation summary",
  "body": "Donation summary from {{ params.from }} to {{ params.to }}. Total {{ calculations.totalMoney }} ({{ calculations.totalWords }}).",
  "html": "<style>@page { size: A4; margin: 16mm; } table thead { display: table-header-group; }</style><div style=\"font-family: Georgia, 'Times New Roman', serif; color: #1e293b; line-height: 1.45;\"><div style=\"border-bottom: 3px solid #1d4e89; padding-bottom: 14px; margin-bottom: 18px;\"><div style=\"font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: #1d4e89; font-weight: 700;\">{{ label }}</div><h1 style=\"margin: 6px 0 0; font-size: 30px; line-height: 1.1; font-weight: 700; color: #0f172a;\">{{ title }}</h1><div style=\"margin-top: 6px; font-size: 14px; color: #475569;\">{{ org.name }}</div></div><table style=\"width: 100%; border-collapse: collapse; margin: 0 0 22px;\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"width: 58%; vertical-align: top; background: #f8fafc; border: 1px solid #e2e8f0; padding: 16px 18px;\"><div style=\"font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #64748b; font-weight: 700;\">Period</div><div style=\"margin-top: 6px; font-size: 16px; font-weight: 700; color: #0f172a;\">{{ formatDate(params.from) }} to {{ formatDate(params.to) }}</div><div style=\"margin-top: 8px; font-size: 13px; color: #475569;\">{{ count(datasets.donations.rows) }} paid donations</div></td><td style=\"width: 12px;\"></td><td style=\"vertical-align: top; background: #1d4e89; color: #f8fafc; padding: 16px 18px;\"><div style=\"font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700;\">Total received</div><div style=\"margin-top: 6px; font-size: 26px; font-weight: 700; line-height: 1.1;\">{{ calculations.totalMoney }}</div><div style=\"margin-top: 8px; font-size: 12px; line-height: 1.35;\">{{ calculations.totalWords }}</div></td></tr></table>{{#if count(datasets.donations.rows)}}<table style=\"width: 100%; border-collapse: collapse;\"><thead><tr><th style=\"text-align: left; padding: 9px 10px; background: #0f172a; color: #f8fafc; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700;\">Donor</th><th style=\"text-align: left; padding: 9px 10px; background: #0f172a; color: #f8fafc; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700;\">Paid on</th><th style=\"text-align: left; padding: 9px 10px; background: #0f172a; color: #f8fafc; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700;\">Method</th><th style=\"text-align: right; padding: 9px 10px; background: #0f172a; color: #f8fafc; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700;\">Amount</th></tr></thead><tbody>{{#each datasets.donations.rows as row}}<tr><td style=\"padding: 9px 10px; border-bottom: 1px solid #e2e8f0; font-size: 13px;\">{{ row.donorName }}</td><td style=\"padding: 9px 10px; border-bottom: 1px solid #e2e8f0; font-size: 13px; color: #334155;\">{{ formatDate(row.paidOn) }}</td><td style=\"padding: 9px 10px; border-bottom: 1px solid #e2e8f0; font-size: 13px; color: #334155;\">{{ row.method }}</td><td style=\"padding: 9px 10px; border-bottom: 1px solid #e2e8f0; font-size: 13px; text-align: right; font-weight: 700;\">{{ formatMoney(row.amount) }}</td></tr>{{/each}}</tbody></table>{{else}}<p style=\"padding: 18px; background: #f8fafc; border: 1px solid #e2e8f0; color: #475569;\">No paid donations in this period.</p>{{/if}}<p style=\"margin-top: 22px; font-size: 11px; color: #94a3b8;\">Prepared {{ formatDate(generatedAt) }}</p></div>"
}
