{
  "key": "membershipFeeRegister",
  "label": "Membership fee register",
  "parameters": [
    { "key": "from", "label": "From", "type": "date", "required": true },
    { "key": "to", "label": "To", "type": "date", "required": true }
  ],
  "datasets": [
    {
      "key": "fees",
      "label": "Fees paid",
      "source": "query",
      "recordType": "membershipFee",
      "statusIn": ["paid"],
      "filters": { "paidOn": { "from": "params.from", "to": "params.to" } },
      "sort": { "field": "paidOn", "dir": "asc" },
      "fields": ["memberName", "amount", "paidOn", "method", "paidTo"]
    }
  ],
  "outputs": {
    "excel": {
      "sheets": [
        {
          "dataset": "fees",
          "columns": [
            { "field": "memberName", "header": "Member", "format": "text" },
            { "field": "amount", "header": "Amount", "format": "money", "total": true },
            { "field": "paidOn", "header": "Paid on", "format": "date" },
            { "field": "method", "header": "Method", "format": "text" },
            { "field": "paidTo", "header": "Received in", "format": "text" }
          ]
        }
      ]
    }
  }
}
