{
  "key": "membershipFee",
  "label": "Membership fee",
  "pluralLabel": "Membership fees",
  "description": "A one-time membership fee paid by a member. A paid fee posts to the books and issues a numbered receipt.",
  "titleField": "memberName",
  "numbering": { "sequence": "membershipFee", "format": "MFEE/{fy}/{seq:5}", "reset": "fiscal_year" },
  "fields": [
    { "key": "member", "label": "Member", "type": "reference", "referenceType": "member", "required": true, "help": "Choose a member to fill in their name and email" },
    {
      "key": "memberName",
      "label": "Member name",
      "type": "text",
      "required": true,
      "maxLength": 200,
      "searchable": true,
      "copyFrom": { "reference": "member", "field": "name" },
      "editableWhen": "isEmpty(record.member)"
    },
    { "key": "memberEmail", "label": "Member email", "type": "email", "copyFrom": { "reference": "member", "field": "email" }, "editableWhen": "isEmpty(record.member)" },
    { "key": "amount", "label": "Fee amount", "type": "money", "required": true, "min": 1, "editableWhen": "status == 'raised'" },
    {
      "key": "paidTo",
      "label": "Received in",
      "type": "choice",
      "visibleWhen": "status == 'paid'",
      "choices": [
        { "value": "BANK", "label": "Bank account" },
        { "value": "CASH", "label": "Cash in hand" }
      ]
    },
    {
      "key": "method",
      "label": "Payment method",
      "type": "choice",
      "visibleWhen": "status == 'paid'",
      "choices": [
        { "value": "upi", "label": "UPI" },
        { "value": "cash", "label": "Cash" },
        { "value": "bank_transfer", "label": "Bank transfer" },
        { "value": "cheque", "label": "Cheque" }
      ]
    },
    { "key": "paidOn", "label": "Paid on", "type": "date", "visibleWhen": "status == 'paid'" },
    { "key": "reference", "label": "Payment reference", "type": "text", "maxLength": 100, "visibleWhen": "status == 'paid'" },
    { "key": "notes", "label": "Notes", "type": "longText" }
  ],
  "rules": [
    {
      "key": "referenceForUpi",
      "when": "status == 'paid' and record.method == 'upi'",
      "expression": "not isEmpty(record.reference)",
      "message": "Enter the UPI transaction reference."
    }
  ]
}
