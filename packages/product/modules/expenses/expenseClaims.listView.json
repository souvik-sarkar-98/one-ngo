{
  "key": "expenseClaims",
  "recordType": "expenseClaim",
  "label": "Expense claims",
  "pageSize": 20,
  "layout": "table",
  "columns": ["number", "title", "category", "amount", "claimedOn", "paidFrom", "paidOn", "status"],
  "compactColumns": ["title", "amount", "status"],
  "chips": [
    { "id": "mine", "label": "Mine", "owner": "me" },
    { "id": "to_approve", "label": "To approve", "statusIn": ["submitted"], "permission": "record:expenseClaim:transition:approve" },
    { "id": "to_pay", "label": "To pay", "statusIn": ["approved"], "permission": "record:expenseClaim:transition:pay" },
    { "id": "closed", "label": "Closed", "statusIn": ["paid", "rejected"] }
  ],
  "defaultChip": "mine",
  "filters": ["category", "claimedOn", "paidFrom"],
  "row": { "title": "title", "subtitle": ["category"], "meta": "amount", "badge": "status" },
  "detail": {
    "sections": [
      { "id": "claim", "label": "Claim", "fields": ["number", "status", "title", "category", "amount", "claimedOn", "notes"] },
      { "id": "bill", "label": "Bill", "fields": ["billFile"] },
      { "id": "payment", "label": "Payment", "fields": ["paidFrom", "paidOn", "reference"] }
    ]
  },
  "create": { "fields": ["title", "category", "amount", "claimedOn", "billFile", "notes"], "chips": ["mine"] },
  "edit": { "fields": ["title", "category", "amount", "claimedOn", "billFile", "notes"], "chips": ["mine"] }
}
