{
  "$id": "recordGroup",
  "title": "Record group",
  "description": "A named group of record types on the home page and the Records screen. Record types in no group are listed under Other.",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "label", "recordTypes"],
  "properties": {
    "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_-]{0,62}$", "description": "Stable name of the group" },
    "label": { "type": "string", "minLength": 1, "maxLength": 60, "description": "Group heading" },
    "order": { "type": "integer", "minimum": 0, "maximum": 1000, "description": "Lower comes first" },
    "recordTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string" },
      "description": "Record types in the group, in order; a record type in several groups shows in the first",
      "x-ref": "recordType",
      "x-preview": "recordGroup"
    }
  }
}
